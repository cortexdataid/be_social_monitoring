APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PostgreSQL (Laravel tables — users, sessions, jobs, etc.)
DB_CONNECTION=pgsql
DB_HOST=apify_postgres
DB_PORT=5432
DB_DATABASE=default
DB_USERNAME=default
DB_PASSWORD=secret

# Remote PostgreSQL — social monitoring data (per-client schemas)
DB_CONNECTION_CORTEX=pgsql
DB_HOST_CORTEX=
DB_PORT_CORTEX=5432
DB_DATABASE_CORTEX=social_monitoring
DB_USERNAME_CORTEX=
DB_PASSWORD_CORTEX=
DB_SSLMODE_CORTEX=prefer

# Not `database`: the default connection is the remote cortex Postgres, so every
# session read/write would cost a round trip across the internet.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Stays on `database` on purpose: a queue needs durable storage shared between
# the web process and the worker, which the file driver cannot provide.
QUEUE_CONNECTION=database

# Same reason as SESSION_DRIVER. CortexDashboardService already names the file
# store explicitly; this keeps anything using the default store off the remote DB.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dashboard cache lifetimes, in seconds. 0 disables that cache.
# Aggregates follow the ingest cadence; the other two describe schema shape.
CORTEX_AGGREGATE_CACHE_TTL=300
CORTEX_FILTER_CACHE_TTL=3600
CORTEX_SCHEMA_CACHE_TTL=3600
